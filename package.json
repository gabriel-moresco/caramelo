{
  "name": "caramelo",
  "scripts": {
    "app": "pnpm --dir apps/app",
    "api": "pnpm --dir apps/api",
    "db": "pnpm --dir packages/db",
    "email": "pnpm --dir packages/email",
    "eslint-config": "pnpm --dir packages/eslint-config",
    "shared": "pnpm --dir packages/shared",
    "typescript-config": "pnpm --dir packages/typescript-config",
    "typecheck": "pnpm -r run typecheck",
    "lint:file": "eslint --fix",
    "format:file": "prettier --write --ignore-unknown",
    "check": "eslint . && prettier --check .",
    "fix": "eslint . --fix && prettier . --write",
    "clear": "./scripts/clear-project.sh"
  },
  "dependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "eslintConfig": {
    "extends": [
      "./packages/eslint-config/node.js"
    ]
  },
  "prettier": "./packages/eslint-config/prettier.config.js",
  "devDependencies": {
    "eslint": "8.57.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.7.2"
  }
}
